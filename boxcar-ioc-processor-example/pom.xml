<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.boxcar</groupId>
        <artifactId>boxcar-ioc</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>boxcar-ioc-processor-example</artifactId>

    <name>Boxcar IoC :: Processor Example</name>
    <description>
        A small Jakarta EE-style application tested with the com.boxcar.Injector generated by the annotation processor,
        set up the way a real project would be: the processor is a test-scoped dependency, javac discovers it
        through META-INF/services, and -Aboxcar.packages points it at the application's root package.
    </description>

    <dependencies>
        <!-- What the application itself needs: the Jakarta APIs it is written against. -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ejb</groupId>
            <artifactId>jakarta.ejb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- Test setup: the processor and JUnit. Being on the test class path (rather than on a separate
             processor path) lets the processor find every class below the configured package prefix. -->
        <dependency>
            <groupId>com.boxcar</groupId>
            <artifactId>boxcar-ioc-processor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <!-- Only the test compilation runs the processor, so the generated Injector never ships
                         with the application. The beans are already compiled by then; the prefix covers
                         com.example.greetings.service and com.example.greetings.repository alike. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-Aboxcar.packages=com.example.greetings</arg>
                                <arg>-Werror</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
